ES_HOSTS=http://localhost:9200
# ES_CLOUD_ID=
# Use only ONE auth method:
# ES_API_KEY=
# ES_USERNAME=elastic
# ES_PASSWORD=
# ES_BEARER_TOKEN=
# ES_CA_CERTS=/path/to/http_ca.crt
# ES_SSL_FINGERPRINT=
ES_VERIFY_CERTS=true
ES_REQUEST_TIMEOUT=10
ES_MAX_RETRIES=3
ES_RETRY_ON_TIMEOUT=false
ES_HTTP_COMPRESS=true
